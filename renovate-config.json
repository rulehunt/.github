{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "automergeType": "pr",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "vulnerabilityAlerts": {
    "automerge": false,
    "enabled": true,
    "minimumReleaseAge": "1 day"
  }
}
